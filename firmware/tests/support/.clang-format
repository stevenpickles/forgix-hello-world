# Formatting for the hand-written BSP fakes.
#
# Identical to firmware/src/bsp/.clang-format. These files stand in for the BSP
# at link time and are read side by side with it, so they follow the same
# layout. Scoped to this directory because the test files one level up are
# still K&R.
#
# See firmware/src/bsp/.clang-format for the full rationale, including the one
# style rule clang-format cannot express (opening brace of a multi-line
# initializer on its own line).

Language: Cpp
BasedOnStyle: LLVM

BreakBeforeBraces: Allman

IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
ColumnLimit: 100

# Allman exists so a block advertises its extent. Collapsing one back onto a
# single line defeats that, so every short-form allowance is off.
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# `const char *const text`, not `const char* const text`.
PointerAlignment: Right

# Includes are grouped by hand -- own header first, then SDK, then system --
# and the blank lines between the groups carry meaning.
SortIncludes: Never

# Keeps `{0}` and `{(char)character, 0}` tight, as the sources already have them.
Cpp11BracedListStyle: true
