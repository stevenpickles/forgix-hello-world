# Formatting for the BSP package. The full rules, including everything
# clang-format cannot express, live in docs/bsp-style-rubric.md; this file is
# the subset a formatter can apply. scripts/check_bsp_style.py scores the rest.
#
# Scoped to this directory on purpose. clang-format reads the nearest config
# walking up from each file, and the application layer above us is still K&R,
# so a repo-root version of this file would quietly reformat code nobody asked
# to change. firmware/tests/support/ carries an identical copy for the fakes.
#
# Nothing runs clang-format today -- it is not installed and CI does not call
# it. This file records the house style so an editor integration formats the
# way the code is already written, and so a future CI check has something to
# check against.
#
# Note the BSP does not conform yet: the rubric was adopted after this code was
# written, so running a formatter over it now produces a large diff by design.
#
# One known divergence. The BSP puts the opening brace of a multi-line
# initializer on its own line:
#
#     const bsp_led_state_t state =
#     {
#         .red = red,
#     };
#
# clang-format cannot express that. Braced initializer lists are governed by
# Cpp11BracedListStyle, which controls spacing only, not brace placement, and
# there is no AfterInitializer under BraceWrapping. Running clang-format will
# pull those braces back onto the `=` line. Three initializers are affected:
# bsp_button.c, bsp_led.c and bsp_usb.c.

Language: Cpp
BasedOnStyle: LLVM

BreakBeforeBraces: Allman

IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
ColumnLimit: 100

# Allman exists so a block advertises its extent. Collapsing one back onto a
# single line defeats that, so every short-form allowance is off.
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# `const char *const text`, not `const char* const text`.
PointerAlignment: Right

# Rubric C1/C3/C4: `BSP_Foo( const uint8_t id )`, `list[ id ]`, `(uint32_t) value`.
# SpacesInParentheses is the pre-17 spelling; clang-format 17+ calls it
# SpacesInParens and wants `Custom` plus a SpacesInParensOptions block. Written
# the older way because that is what the widest range of versions accepts.
SpacesInParentheses: true
SpacesInSquareBrackets: true
SpaceAfterCStyleCast: true

# Includes are grouped by hand -- own header first, then SDK, then system --
# and the blank lines between the groups carry meaning.
SortIncludes: Never

# Keeps `{0}` and `{CMD_PING}` tight, as the sources already have them.
Cpp11BracedListStyle: true
